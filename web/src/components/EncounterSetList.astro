---
import type { EncounterSetRef } from '@scripts/lib/types.js';

interface Props {
  sets: EncounterSetRef[];
  label?: string;
}

const { sets, label = 'Encounter Sets' } = Astro.props;
---

<div class="encounter-sets">
  <h3>{label}</h3>
  <ul>
    {sets.map((set) => (
      <li>
        <span class="set-name">{set.name}</span>
        <span class="set-code">{set.code}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .encounter-sets {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem;
  }

  h3 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  ul {
    list-style: none;
  }

  li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  li:last-child {
    border-bottom: none;
  }

  .set-name {
    font-size: 0.9rem;
  }

  .set-code {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: monospace;
  }
</style>
